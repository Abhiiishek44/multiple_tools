# Local infrastructure used by the API.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9003

# API runtime connections.
LOG_LEVEL=INFO
DATABASE_URL=postgresql://app:app@localhost:5433/app
CELERY_BROKER_URL=redis://localhost:6380/0

# Object storage.
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=multiple-tools
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_ADDRESSING_STYLE=auto
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true
MINIO_TEMP_PREFIX=jobs/

# API request limits.
MAX_UPLOAD_BYTES=52428800

# Google OAuth configuration.
GOOGLE_CLIENT_ID=

# Generate JWT_SECRET and API_KEY_HMAC_SECRET independently:
# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=multiple-tools-api
JWT_AUDIENCE=multiple-tools-web
API_KEY_HMAC_SECRET=

# Browser integration.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
AUTH_COOKIE_NAME=multiple_tools_access_token
AUTH_COOKIE_SECURE=false
