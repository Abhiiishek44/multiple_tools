# Worker runtime connections. Keep these values aligned with api.env.
LOG_LEVEL=INFO
DATABASE_URL=postgresql://app:app@localhost:5433/app
CELERY_BROKER_URL=redis://localhost:6380/0

# Object storage. Keep these values aligned with api.env.
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=multiple-tools
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_ADDRESSING_STYLE=auto
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true
MINIO_TEMP_PREFIX=jobs/

# Temporary artifact cleanup performed by Celery Beat.
MINIO_TEMP_RETENTION_MINUTES=30
MINIO_CLEANUP_INTERVAL_MINUTES=30

# OpenRouter OCR provider. Keep this key on backend processes only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_OCR_MODEL=
OPENROUTER_TIMEOUT_SECONDS=120

# OCR input safety limits.
OCR_MAX_PIXELS=40000000
OCR_MAX_PAYLOAD_BYTES=20971520
