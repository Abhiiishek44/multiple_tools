# Local-development defaults. Replace the password outside local development.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9003
DATABASE_URL=postgresql://app:app@localhost:5433/app
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1
STORAGE_BACKEND=minio
MAX_UPLOAD_BYTES=52428800
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=multiple-tools
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_AUTO_CREATE_BUCKET=true
MINIO_TEMP_PREFIX=jobs/
MINIO_TEMP_RETENTION_MINUTES=30
MINIO_CLEANUP_INTERVAL_MINUTES=30

# OpenRouter-only OCR configuration. Keep the API key on the worker/backend.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_OCR_MODEL=
OPENROUTER_TIMEOUT_SECONDS=120
OCR_MAX_PIXELS=40000000
OCR_MAX_PAYLOAD_BYTES=20971520

# Google OAuth web client ID used by the API to verify Google ID tokens.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_BASE_URL=http://localhost:8000

# Backend-only secret. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=multiple-tools-api
CORS_ORIGINS=http://localhost:5173
# Frontend origin; Google authentication redirects to its /dashboard route.
FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
