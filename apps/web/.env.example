# VITE_ values are embedded in browser code and must never contain secrets.
# Vite proxies /api to the local FastAPI server, keeping auth cookies same-origin.
VITE_API_BASE_URL=/api
# Set this to a remote API origin when the frontend runs locally against a deployed backend.
API_PROXY_TARGET=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=
VITE_SITE_URL=http://localhost:5173
